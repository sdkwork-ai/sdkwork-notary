
SDKWORK_NOTARY_DEPLOYMENT_PROFILE=cloud
SDKWORK_NOTARY_ENVIRONMENT=development
SDKWORK_NOTARY_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTARY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=https://notary-dev.sdkwork.com
SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL=https://notary-admin-dev.sdkwork.com
SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

VITE_SDKWORK_NOTARY_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=https://notary-dev.sdkwork.com
VITE_SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL=https://notary-admin-dev.sdkwork.com
VITE_SDKWORK_NOTARY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_NOTARY_WEB_DEV_INGRESS_BIND=127.0.0.1:4269
SDKWORK_NOTARY_PC_INTERNAL_DEV_PORT=4271
SDKWORK_NOTARY_H5_INTERNAL_DEV_PORT=4272


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4269,http://localhost:4269,https://notary-dev.sdkwork.com,http://notary-dev.sdkwork.com,https://notary-dev.birdcoder.com,http://notary-dev.birdcoder.com,https://notary-dev.dtupay.com,http://notary-dev.dtupay.com,https://notary-dev.noaper.com,http://notary-dev.noaper.com,https://notary-dev.sdkwork.cn,http://notary-dev.sdkwork.cn,https://notary-dev.birdcoder.cn,http://notary-dev.birdcoder.cn,https://notary-dev.dtupay.cn,http://notary-dev.dtupay.cn,https://notary-dev.noaper.cn,http://notary-dev.noaper.cn,https://notary-dev.skubc.com,http://notary-dev.skubc.com,https://notary-dev.skubc.cn,http://notary-dev.skubc.cn,https://notary-dev.zowalk.com,http://notary-dev.zowalk.com,https://notary-dev.zowalk.cn,http://notary-dev.zowalk.cn,https://notary-dev.offer86.com,http://notary-dev.offer86.com,https://notary-dev.offer86.cn,http://notary-dev.offer86.cn,https://notary-dev.86offer.com,http://notary-dev.86offer.com,https://notary-dev.86offer.cn,http://notary-dev.86offer.cn,https://notary-admin-dev.sdkwork.com,http://notary-admin-dev.sdkwork.com,https://notary-admin-dev.birdcoder.com,http://notary-admin-dev.birdcoder.com,https://notary-admin-dev.dtupay.com,http://notary-admin-dev.dtupay.com,https://notary-admin-dev.noaper.com,http://notary-admin-dev.noaper.com,https://notary-admin-dev.sdkwork.cn,http://notary-admin-dev.sdkwork.cn,https://notary-admin-dev.birdcoder.cn,http://notary-admin-dev.birdcoder.cn,https://notary-admin-dev.dtupay.cn,http://notary-admin-dev.dtupay.cn,https://notary-admin-dev.noaper.cn,http://notary-admin-dev.noaper.cn,https://notary-admin-dev.skubc.com,http://notary-admin-dev.skubc.com,https://notary-admin-dev.skubc.cn,http://notary-admin-dev.skubc.cn,https://notary-admin-dev.zowalk.com,http://notary-admin-dev.zowalk.com,https://notary-admin-dev.zowalk.cn,http://notary-admin-dev.zowalk.cn,https://notary-admin-dev.offer86.com,http://notary-admin-dev.offer86.com,https://notary-admin-dev.offer86.cn,http://notary-admi