# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Notary is a domain library; host applications wire sdkwork-routes-notary-* crates and load this
# profile. Its persistent state (when a host enables it) MUST use a dedicated PostgreSQL schema/user
# `sdkwork_notary_demo` and a dedicated Redis prefix `notary-demo` on a distinct logical DB index so
# no key collides with another env sharing the deployment Redis.
SDKWORK_NOTARY_DEPLOYMENT_PROFILE=standalone
SDKWORK_NOTARY_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_NOTARY_PROFILE_ID=standalone.demo
SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=https://notary-demo.sdkwork.com
SDKWORK_NOTARY_WEB_DEV_INGRESS_BIND=127.0.0.1:4269
SDKWORK_NOTARY_PC_INTERNAL_DEV_PORT=4271
SDKWORK_NOTARY_H5_INTERNAL_DEV_PORT=4272
SDKWORK_NOTARY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
VITE_SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTARY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://notary-demo.sdkwork.com,http://notary-demo.sdkwork.com,https://notary-demo.birdcoder.com,http://notary-demo.birdcoder.com,https://notary-demo.dtupay.com,http://notary-demo.dtupay.com,https://notary-demo.noaper.com,http://notary-demo.noaper.com,https://notary-demo.sdkwork.cn,http://notary-demo.sdkwork.cn,https://notary-demo.birdcoder.cn,http://notary-demo.birdcoder.cn,https://notary-demo.dtupay.cn,http://notary-demo.dtupay.cn,https://notary-demo.noaper.cn,http://notary-demo.noaper.cn,https://notary-demo.skubc.com,http://notary-demo.skubc.com,https://notary-demo.skubc.cn,http://notary-demo.skubc.cn,https://notary-demo.zowalk.com,http://notary-demo.zowalk.com,https://notary-demo.zowalk.cn,http://notary-demo.zowalk.cn,https://notary-demo.offer86.com,http://notary-demo.offer86.com,https://notary-demo.offer86.cn,http://notary-demo.offer86.cn,https://notary-demo.86offer.com,http://notary-demo.86offer.com,https://notary-demo.86offer.cn,http://notary-demo.86offer.cn,https://notary-admin-demo.sdkwork.com,http://notary-admin-demo.sdkwork.com,https://notary-admin-demo.birdcoder.com,http://notary-admin-demo.birdcoder.com,https://notary-admin-demo.dtupay.com,http://notary-admin-demo.dtupay.com,https://notary-admin-demo.noaper.com,http://notary-admin-demo.noaper.com,https://notary-admin-demo.sdkwork.cn,http://notary-admin-demo.sdkwork.cn,https://notary-admin-demo.birdcoder.cn,http://notary-admin-demo.birdcoder.cn,https://notary-admin-demo.dtupay.cn,http://notary-admin-demo.dtupay.cn,https://notary-admin-demo.noaper.cn,http://notary-admin-demo.noaper.cn,https://notary-admin-demo.skubc.com,http://notary-admin-demo.skubc.com,https://notary-admin-demo.skubc.cn,http://notary-admin-demo.skubc.cn,https://notary-admin-demo.zowalk.com,http://notary-admin-demo.zowalk.com,https://notary-admin-demo.zowalk.cn,http://notary-admin-demo.zowalk.cn,https://notary-admin-demo.offer86.com,http://notary-admin-demo.offer86.com,https://notary-admin-demo.offer86.cn,htt