
SDKWORK_NOTARY_DEPLOYMENT_PROFILE=standalone
SDKWORK_NOTARY_ENVIRONMENT=production
SDKWORK_NOTARY_PROFILE_ID=standalone.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTARY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=https://notary.sdkwork.com
SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL=https://notary-admin.sdkwork.com

VITE_SDKWORK_NOTARY_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_NOTARY_APPLICATION_PUBLIC_HTTP_URL=https://notary.sdkwork.com
VITE_SDKWORK_NOTARY_APPLICATION_BACKEND_HTTP_URL=https://notary-admin.sdkwork.com

# Inject from secret manager at deploy time; required for PII field encryption in production.
# NOTARY_PII_VAULT_KEY=
SDKWORK_NOTARY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
SDKWORK_NOTARY_PC_STATIC_ROOT=/usr/share/sdkwork/notary/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://notary.sdkwork.com,https://notary.birdcoder.com,https://notary.dtupay.com,https://notary.noaper.com,https://notary.sdkwork.cn,https://notary.birdcoder.cn,https://notary.dtupay.cn,https://notary.noaper.cn,https://notary.skubc.com,https://notary.skubc.cn,https://notary.zowalk.com,https://notary.zowalk.cn,https://notary.offer86.com,https://notary.offer86.cn,https://notary.86offer.com,https://notary.86offer.cn,https://notary-admin.sdkwork.com,https://notary-admin.birdcoder.com,https://notary-admin.dtupay.com,https://notary-admin.noaper.com,https://notary-admin.sdkwork.cn,https://notary-admin.birdcoder.cn,https://notary-admin.dtupay.cn,https://notary-admin.noaper.cn,https://notary-admin.skubc.com,https://notary-admin.skubc.cn,https://notary-admin.zowalk.com,https://notary-admin.zowalk.cn,https://notary-admin.offer86.com,https://notary-admin.offer86.cn,https://notary-admin.86offer.com,https://notary-admin.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
